#!/usr/bin/env bash
# Block a push whose commits, messages or branch name contain sensitive
# content. Git passes one line per pushed ref on stdin:
#   <local ref> <local sha> <remote ref> <remote sha>
set -euo pipefail
check="$(git rev-parse --show-toplevel)/scripts/check-sensitive.sh"
zero_sha=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  # A deleted ref pushes no content.
  [ "$local_sha" = "$zero_sha" ] && continue
  branch=${remote_ref#refs/heads/}
  branch=${branch#refs/tags/}
  # The loop reads the ref list from stdin, so keep the scan and any tool it
  # runs, such as gitleaks, from consuming the remaining refs.
  "$check" range "$remote_sha" "$local_sha" "$branch" </dev/null || status=1
done
exit "$status"
